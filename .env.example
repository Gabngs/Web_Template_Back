APP_NAME="LCS Backend"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=America/Lima

# Puerto HTTP local (docker-compose.yml) — ajustado para no chocar con otros
# proyectos que ya usan el 8877 por defecto de Sail.
APP_PORT=8844

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# ── Docker / Sail — requeridas por docker-compose.yml ───────────────────────
# WWWUSER/WWWGROUP: uid/gid del usuario dentro del contenedor (build arg del
# Dockerfile de Sail). Si quedan vacíos, el build falla en "groupadd". 1000 es
# el default estándar de Sail y funciona en Docker Desktop (Windows/Mac).
WWWUSER=1000
WWWGROUP=1000

# DB_USERNAME/DB_PASSWORD: usados directamente por docker-compose.yml para
# crear el usuario de MariaDB en el primer arranque (MYSQL_USER/MYSQL_PASSWORD/
# MYSQL_ROOT_PASSWORD). database/docker-init/01_init_databases.sql otorga
# privilegios a un usuario "sail" hardcodeado — este valor DEBE ser "sail" o
# los GRANT de ese script fallan. Debe coincidir con
# DB_LCS_USERNAME/DB_SIAW_USERNAME/DB_SINCRO_USERNAME/PASSWORD de abajo.
DB_USERNAME=sail
DB_PASSWORD=123456

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Conexión por defecto — dbsiaw (usuarios/auth) ───────────────────────────
DB_CONNECTION=dbsiaw

# ── DB Negocio propio del proyecto (tablas {prefijo}_*) — vacía hasta que se
#    agregue el primer módulo de negocio bajo database/migrations/{Modulo} ──
DB_LCS_HOST=lcs_db
DB_LCS_PORT=3306
DB_LCS_DATABASE=db_lcs
DB_LCS_USERNAME=sail
DB_LCS_PASSWORD=123456

# ── DB SIAW — usuarios/roles/permisos/menús (tablas siaw_*, fija) ──────────
DB_SIAW_HOST=lcs_db
DB_SIAW_PORT=3306
DB_SIAW_DATABASE=db_siaw
DB_SIAW_USERNAME=sail
DB_SIAW_PASSWORD=123456

# ── DB Sincro — ledger de migraciones + seeders_log, jobs, cache (fija) ────
DB_SINCRO_HOST=lcs_db
DB_SINCRO_PORT=3306
DB_SINCRO_DATABASE=db_sincro
DB_SINCRO_USERNAME=sail
DB_SINCRO_PASSWORD=123456

# ── Credenciales de RUNTIME de la app (opcional) ───────────────────────────
#    Si están seteadas, TODAS las conexiones las usan en vez de los
#    DB_*_USERNAME/PASSWORD per-conexión de arriba. En prod:
#      - pods api/queue/scheduler  → DB_RUNTIME_USER=lcs_app     (solo DML)
#      - el Job de migración        → DB_RUNTIME_USER=lcs_migrate (DML + DDL)
#    En local se dejan sin definir (cae al fallback = sail). Ver docs/RUNBOOK_BD_Y_SEGURIDAD.md.
# DB_RUNTIME_USER=
# DB_RUNTIME_PASS=

#    Solo las lee k8s/scripts/ensure-databases.php (crea los usuarios acotados):
# DB_APP_USERNAME=lcs_app
# DB_APP_PASSWORD=
# DB_MIGRATE_USERNAME=lcs_migrate
# DB_MIGRATE_PASSWORD=
# DB_ROOT_PASSWORD=            # root de MariaDB — en prod va en el secret lcs-db-root

SESSION_DRIVER=database
SESSION_CONNECTION=dbsincro
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_CONNECTION=dbsincro

CACHE_STORE=redis
DB_CACHE_CONNECTION=dbsincro
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=lcs_redis
# En prod: poblar REDIS_PASSWORD en el secret lcs-db-users → redis exige auth.
# En local: null (sin auth).
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Correo — password temporal al crear/resetear un usuario ─────────────────
# Local: lcs_mailpit captura los correos sin mandarlos a internet (ver
# http://localhost:8026). Producción: Resend (dominio propio verificado por
# DNS, remitente no-reply@{dominio} real, sin necesitar un casillero pago).
# Paquete resend/resend-php ya instalado — solo falta setear las 3 vars de
# abajo comentadas. Estas credenciales van en el Secret de despliegue, nunca
# en este archivo.
MAIL_MAILER=smtp
MAIL_HOST=lcs_mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Producción:
# MAIL_MAILER=resend
# RESEND_API_KEY=re_xxx
# MAIL_FROM_ADDRESS="no-reply@tudominio.com"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── CORS — dominio del frontend ─────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ── Swagger (l5-swagger) ─────────────────────────────────────────────────────
# Sin definir: encendido en local/staging, apagado automáticamente si
# APP_ENV=production (ver config/l5-swagger.php + EnsureSwaggerEnabled).
# Poner explícitamente en false para apagarlo también fuera de producción.
# L5_SWAGGER_ENABLED=true
L5_SWAGGER_CONST_HOST=http://localhost:8844

# ── Discord — notificaciones de deploy (CI/CD, ver docs/CONFIGURAR_SECRETS.md) ──
DISCORD_WEBHOOK_URL=

# ── Usuario admin inicial — sembrado una sola vez por SiawUsuarioAdminSeeder ──
# Valor genérico a propósito (no expone nada real). Para tu email/password
# reales: .env local (gitignorado) o el secret lcs-env de K8s en prod —
# nunca en este archivo. Ver docs/CONFIGURAR_SECRETS.md.
SIAW_ADMIN_EMAIL_INICIAL=admin@example.com
SIAW_ADMIN_PASSWORD_INICIAL=Cambiar123!
